{
  "expo": {
    "name": "411-Azevedo",
    "slug": "411-Azevedo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "plan411azevedo",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.borderlesspc2.plan411azevedo"
    },
    "android": {
      "package": "com.borderlesspc2.plan411azevedo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8c52ff",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "owner": "visao",
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "be2008b3-c7c7-453f-af2c-2cf82fcfcd56"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/be2008b3-c7c7-453f-af2c-2cf82fcfcd56"
    }
  }
}
